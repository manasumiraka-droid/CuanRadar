# CuanRadar — environment template
# .env.local = frontend (Vite) · .env = server-side script (db:seed membaca .env via --env-file)

# Supabase (project URL & anon key — client-side, aman dipakai di browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Project URL untuk script server-side (nilai sama dengan VITE_SUPABASE_URL)
SUPABASE_URL=

# Service role key — SERVER-SIDE ONLY (scripts/seed-supabase.mjs, edge functions).
# JANGAN pernah dipakai atau di-commit di frontend (AI_RULES §9).
# Sumber: Supabase dashboard → Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=

# --- Edge Function scan (server-side, BUILD 5.1) ---
# Search provider: brave | serper. Deep Scan menolak request bila provider belum siap.
SEARCH_PROVIDER=brave
SEARCH_API_KEY=

# AI provider (DeepSeek — OpenAI-compatible). Daftar di https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Origin frontend yang boleh memanggil Edge Function (dipisahkan koma, tanpa wildcard).
ALLOWED_ORIGINS=https://cuanradar.pages.dev,http://localhost:5173

# Salt acak minimal 32 byte untuk hashing IP tamu. SERVER-SIDE ONLY.
RATE_LIMIT_SALT=

# Budget harian provider; default konservatif untuk Public Beta.
DAILY_PROVIDER_BUDGET_USD=1
SEARCH_COST_PER_REQUEST_USD=0.005
AI_INPUT_USD_PER_MILLION=0.44
AI_OUTPUT_USD_PER_MILLION=1.32
AI_RESERVED_INPUT_TOKENS=12000

# --- Analytics (BUILD 5, opsional — PostHog) ---
# Kosongkan bila tidak dipakai (semua capture jadi no-op). Key dari https://us.posthog.com
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
