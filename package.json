{
  "name": "cuanradar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CuanRadar — reward opportunity discovery assistant untuk Indonesia (F0 skeleton).",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:seed": "node --env-file=.env scripts/seed-supabase.mjs",
    "scan:quick": "node --env-file=.env scripts/run-scan.mjs --type quick",
    "scan:deep": "node --env-file=.env scripts/run-scan.mjs --type deep"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "posthog-js": "^1.422.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
